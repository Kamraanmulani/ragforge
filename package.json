{
  "name": "ragforge",
  "version": "1.1.0",
  "description": "Find the RAG query technique that works on your data, then use it automatically. HyDE, Step-Back, Fan-Out, Chain-of-Thought and RRF, benchmarked on your documents and routed per query, for OpenAI, Ollama and any vector database.",
  "keywords": [
    "rag",
    "genai",
    "retrieval-augmented-generation",
    "hyde",
    "chain-of-thought",
    "step-back",
    "rrf",
    "fan-out",
    "ai",
    "query-translation",
    "llm",
    "openai",
    "ollama",
    "vector-search",
    "embeddings",
    "query-expansion",
    "evaluation",
    "benchmark",
    "rag-evaluation"
  ],
  "homepage": "https://github.com/Kamraanmulani/ragforge#readme",
  "bugs": {
    "url": "https://github.com/Kamraanmulani/ragforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kamraanmulani/ragforge.git"
  },
  "license": "MIT",
  "author": "kamraanmulani",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "ragforge": "bin/ragforge.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:watch": "jest tests/unit --watch",
    "typecheck": "tsc --noEmit --strict index.d.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "openai": "^6.1.0"
  },
  "devDependencies": {
    "@qdrant/js-client-rest": "^1.15.1",
    "jest": "^30.2.0",
    "typescript": "^5.9.3"
  }
}
