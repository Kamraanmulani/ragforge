    "query-translation",
    "llm",
    "openai",
    "ollama",
    "vector-search",
    "embeddings",
    "query-expansion",
    "evaluation",
    "benchmark",
    "rag-evaluation"
  ],
  "homepage": "https://github.com/Kamraanmulani/ragforge#readme",
  "bugs": {
    "url": "https://github.com/Kamraanmulani/ragforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kamraanmulani/ragforge.git"
  },
  "license": "MIT",
  "author": "kamraanmulani",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "ragforge": "bin/ragforge.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
