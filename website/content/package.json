{
  "name": "ragforge",
  "version": "2.4.0",
  "description": "AutoRAG for JavaScript: find the RAG setup that works on your documents, then ship it. Benchmarks query techniques (HyDE, Step-Back, Fan-Out, hybrid BM25, reranking, contextual retrieval) and tunes chunking, chunk size and embedding model within a budget, then routes every query with the winner. Saved incremental index with --watch, answer-quality eval with an LLM judge, CI regression checks, a local dashboard, an MCP server, and adapters for LangChain, the Vercel AI SDK, LlamaIndex and Mastra. Works with OpenAI, Anthropic, Gemini, Ollama, local embeddings and any vector database.",
  "keywords": [
    "rag",
    "genai",
    "retrieval-augmented-generation",
    "hyde",
    "chain-of-thought",
    "step-back",
    "rrf",
    "fan-out",
    "ai",
    "query-translation",
    "llm",
    "openai",
    "ollama",
    "vector-search",
    "embeddings",
    "query-expansion",
    "evaluation",
    "benchmark",
    "rag-evaluation",
    "hybrid-search",
    "bm25",
    "reranker",
    "rerank",
    "cohere",
    "citations",
    "pdf",
    "mcp",
    "mcp-server",
    "faithfulness",
    "llm-as-judge",
    "regression-testing",
    "github-action",
    "rag-pipeline",
    "langchain",
    "ai-sdk",
    "vercel-ai-sdk",
    "llamaindex",
    "mastra",
    "retriever",
    "autorag",
    "rag-tuning",
    "hyperparameter-tuning",
    "chunking",
    "contextual-retrieval",
    "incremental-indexing",
    "dashboard"
  ],
  "homepage": "https://github.com/Kamraanmulani/ragforge#readme",
  "bugs": {
    "url": "https://github.com/Kamraanmulani/ragforge/issues"
  },
  "repository": {
    "type": "git",
